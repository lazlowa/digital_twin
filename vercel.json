{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.lazlowa.space" }],
      "destination": "https://lazlowa.space/$1",
      "permanent": true
    }
  ]
}
