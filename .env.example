# Copy to .env and fill in. Never commit .env.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OpenRouter model id; must support tool calling
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Serve the model only through this OpenRouter provider (named in the privacy
# notice); empty allows any provider
OPENROUTER_PROVIDER=anthropic

# SMTP server used to send unknown-question notifications
EMAIL_SMTP_SERVER=smtp.gmail.com
# Sender account; for Gmail an App Password (requires 2-step verification)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Recipient of unknown-question notifications
NOTIFY_TO=

# Pushover credentials; optional, not used yet
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Abuse and cost limits for POST /api/chat (defaults shown)
# Max characters per visitor message
MAX_MESSAGE_CHARS=2000
# Max messages in the conversation history sent by the client
MAX_HISTORY_MESSAGES=40
# Max tokens per model response
MAX_RESPONSE_TOKENS=1000
# Requests allowed per client IP (in-memory, per server process)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
# Unanswered-question emails per client IP per 24 hours (in-memory); further
# questions are not emailed
MAX_QUESTION_EMAILS_PER_DAY=10
# Read the client IP from X-Real-IP / X-Forwarded-For; enable only behind a
# proxy that sets these headers itself (true on Vercel)
TRUST_PROXY_HEADERS=false
