# Copy to .env and fill in. Never commit .env.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OpenRouter model id; must support tool calling
OPENROUTER_MODEL=

# Gmail account used to send unknown-question notifications
GMAIL_ADDRESS=
# Gmail App Password (requires 2-step verification on the account)
GMAIL_APP_PASSWORD=
# Recipient of unknown-question notifications
NOTIFY_TO=
